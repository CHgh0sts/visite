generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Carte complète des boutons d’interaction (toutes les scènes), JSON unique.
model SceneInteractionsSnapshot {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
}
